# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit it.

# --- Dashboard login -------------------------------------------------------
# Leave DASH_PASSWORD empty to run without a login (safe only on 127.0.0.1).
# REQUIRED if you expose the dashboard beyond localhost (Docker, tunnel, VPS).
DASH_USERNAME=admin
DASH_PASSWORD=change-me-to-a-strong-password

# --- Optional --------------------------------------------------------------
# Hugging Face token — faster Whisper model downloads / higher rate limits.
HF_TOKEN=

# Timezone used for timestamps in the dashboard (Docker).
TZ=Asia/Jakarta

# Max TOTAL upload size per request, in MB (a folder upload counts as one request).
DASH_MAX_UPLOAD_MB=8192

# Where Ollama runs. Inside Docker this must point at the host machine.
# ACF_LLM_HOST=http://host.docker.internal:11434

# Google OAuth redirect. Change the port if you publish the dashboard elsewhere.
# OAUTH_REDIRECT_URL=http://localhost:5000/oauth2cb
